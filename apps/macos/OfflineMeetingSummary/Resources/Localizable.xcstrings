    "The session has no transcript yet." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ešte nemá prepis."
          }
        }
      }
    },
    "The session is busy. Wait until its work ends." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session práve pracuje. Počkajte, kým práca skončí."
          }
        }
      }
    },
    "The sessions overlap in time, so you cannot merge them." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions sa časovo prekrývajú, preto sa nedajú zlúčiť."
          }
