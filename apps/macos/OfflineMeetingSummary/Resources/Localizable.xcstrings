    },
    "The update installs when the current job is done." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizácia sa nainštaluje po skončení aktuálnej úlohy."
          }
        }
      }
    },
    "The video always stays on the Mac. Transcription runs locally unless you select a server. The summary goes to the model you choose: with a local model in OpenCode, nothing leaves the Mac. The app sends no telemetry. The update check only downloads the public list of versions from GitHub." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video zostáva vždy na Macu. Prepis beží lokálne, ak nevyberiete server. Zápis ide do modelu, ktorý si vyberiete: s lokálnym modelom v OpenCode neopustí Mac nič. Aplikácia neposiela telemetriu. Kontrola aktualizácií len stiahne verejný zoznam verzií z GitHubu."
          }
        }
      }
    },
    "The video and audio of this session are deleted." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video a zvuk tejto session sú vymazané."
