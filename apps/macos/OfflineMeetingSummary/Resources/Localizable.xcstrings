        }
      }
    },
    "A session without audio and without a transcript cannot be merged." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session bez zvuku a bez prepisu sa nedá zlúčiť."
