    "A local model turns the speech into a transcript with time stamps. The audio stays on the Mac." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokálny model prepíše reč na text s časmi. Zvuk zostane na Macu."
          }
        }
      }
    },
    "A merge did not finish. No file was deleted. Check the session %@." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlúčenie sa nedokončilo. Žiadny súbor sa nevymazal. Skontrolujte session %@."
          }
        }
      }
    },
    "A model writes the summary from the transcript and a template. It can look at screen frames." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model napíše zápis z prepisu podľa šablóny. Môže si pozrieť snímky obrazovky."
          }
        }
      }
    },
    "A session can have at most 99 parts." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session môže mať najviac 99 častí."
          }
        }
      }
    },
    "A session cannot merge with itself." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session sa nedá zlúčiť sama so sebou."
          }
        }
      }
    },
    "A session that records cannot be merged." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session, ktorá sa nahráva, sa nedá zlúčiť."
