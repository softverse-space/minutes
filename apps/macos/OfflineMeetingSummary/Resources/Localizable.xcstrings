          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinky"
          }
        }
      }
    },
    "With the video, the minutes can use pictures of the screen. Without it, the session uses less disk space. The original file stays where it is." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S videom môže zápisnica použiť obrázky obrazovky. Bez neho zaberá session menej miesta na disku. Pôvodný súbor zostane na svojom mieste."
          }
        }
      }
    },
    "Write a custom instruction for the summary you want." : {
      "localizations" : {
