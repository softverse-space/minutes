    "The transcript is done" : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepis je hotový"
          }
        }
      }
    },
    "The transcript is done, the summary is not" : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
