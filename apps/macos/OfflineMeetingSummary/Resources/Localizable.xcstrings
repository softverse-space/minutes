      }
    },
    "The sessions were not merged: %@" : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions sa nezlúčili: %@"
          }
        }
      }
    },
    "The summary is done" : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zápis je hotový"
          }
        }
      }
    },
    "The summary rules are the same for all models. The app keeps them in ~/Library/Application Support/OfflineMeetingSummary/prompts/meeting-summary.md. Your changes apply from the next summary. A new app version updates the file only when you did not edit it." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravidlá zápisu sú rovnaké pre všetky modely. Aplikácia ich má v ~/Library/Application Support/OfflineMeetingSummary/prompts/meeting-summary.md. Vaše zmeny platia od nasledujúceho zápisu. Nová verzia aplikácie súbor aktualizuje, len keď ste ho neupravili."
          }
        }
      }
    },
    "The summary was cancelled." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zápis bol zrušený."
          }
        }
      }
    },
    "The transcript and selected frames go to %@ (cloud). Use this only for meetings that are not sensitive." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepis a vybrané snímky odídu do %@ (cloud). Použite iba pre stretnutia, ktoré nie sú citlivé."
          }
        }
      }
    },
    "The transcript contains no speech." : {
      "localizations" : {
